# NextAuth — NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Google OAuth "Web application" client (same one the backend uses)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account can sign in
ALLOWED_EMAIL=you@gmail.com
# Backend (server-side only, never exposed to the browser). BACKEND_API_KEY must match the backend's.
BACKEND_URL=http://localhost:4000
BACKEND_API_KEY=
